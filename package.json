{
  "name": "chise-ids-inline-renderer",
  "version": "0.2.0-dev.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:pages": "vite build --config vite.pages.config.ts",
    "calibration:build:corpus": "node --experimental-strip-types tools/calibration/generate-corpus.ts",
    "calibration:build:multisource": "node --experimental-strip-types tools/calibration/generate-multisource-corpus.ts",
    "calibration:build:source": "node --experimental-strip-types tools/calibration/generate-source-corpus.ts",
    "calibration:verify-fonts": "node --experimental-strip-types tools/calibration/fonts/fetch-fonts.ts",
    "calibration:measure:sample": "node --experimental-strip-types tools/calibration/measure-calibration-sample.ts",
    "calibration:measure:operator": "node --experimental-strip-types tools/calibration/measure-operator.ts",
    "dev": "vite --config vite.config.ts",
    "known:import:chise": "node --experimental-strip-types tools/known/import-chise-ids.ts",
    "known:import:babelstone": "node --experimental-strip-types tools/known/import-babelstone-ids.ts",
    "known:import:yibai": "node --experimental-strip-types tools/known/import-yibai-ids.ts",
    "known:merge": "node --experimental-strip-types tools/known/merge-known-sources.ts",
    "pack:check": "npm pack --dry-run",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/public-api.d.ts",
      "import": "./dist/ids-composit.js"
    },
    "./style.css": "./dist/ids-composit.css"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@types/jsdom": "latest",
    "@types/node": "latest",
    "fontkit": "2.0.4",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
